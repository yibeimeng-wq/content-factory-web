# Copy this file to .env and fill in the values before building

# OAuth Portal URL (required for login button - must be a valid URL)
VITE_OAUTH_PORTAL_URL=https://auth.manus.im
VITE_APP_ID=content-factory

# Server-side OAuth
OAUTH_SERVER_URL=https://auth.manus.im

# Database
DATABASE_URL=file:./dev.db
